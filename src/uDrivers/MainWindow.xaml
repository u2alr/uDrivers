<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="uDrivers.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:uDrivers.Models"
    xmlns:vm="using:uDrivers.ViewModels"
    Title="uDrivers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (content extends into it; Mica shows through) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="uDrivers" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border Visibility="{x:Bind vm:Bind.CollapsedIf(ViewModel.IsElevated)}"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="4" Padding="6,1">
                    <TextBlock Text="Read-only" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Updates" Tag="updates">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.Updates.Count, Mode=OneWay}"
                                   Visibility="{x:Bind vm:Bind.VisibleIfAny(ViewModel.Updates.Count), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Installed drivers" Tag="drivers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE964;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- ================= UPDATES ================= -->
                <Grid x:Name="UpdatesPanel" Padding="32,24,32,24" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hero card -->
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="24" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE895;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind vm:Bind.LastChecked(ViewModel.LastChecked), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"
                                    Visibility="{x:Bind vm:Bind.VisibleIf(ViewModel.IsBusy), Mode=OneWay}" />
                            <Button Content="Check for updates" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.CheckCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Messages -->
                    <InfoBar Grid.Row="1"
                             IsOpen="{x:Bind ViewModel.MessageOpen, Mode=TwoWay}"
                             Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                             Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" />

                    <!-- Progress -->
                    <StackPanel Grid.Row="2" Spacing="6"
                                Visibility="{x:Bind vm:Bind.VisibleIf(ViewModel.IsBusy), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" />
                        <ProgressBar IsIndeterminate="True" />
                    </StackPanel>

                    <!-- Results -->
                    <Grid Grid.Row="3">
                        <!-- Empty: up to date -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind vm:Bind.VisibleIfEmpty(ViewModel.Updates.Count, ViewModel.HasChecked), Mode=OneWay}">
                            <FontIcon Glyph="&#xE73E;" FontSize="48" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="Nothing to install" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Windows Update has no newer drivers for this PC right now." HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Grid RowSpacing="8" Visibility="{x:Bind vm:Bind.VisibleIfAny(ViewModel.Updates.Count), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <HyperlinkButton Content="Select all" Command="{x:Bind ViewModel.SelectAllCommand}" />
                                    <HyperlinkButton Content="Select none" Command="{x:Bind ViewModel.SelectNoneCommand}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.InstallSelectedCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                                        <TextBlock Text="Install selected" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Updates}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DriverUpdate">
                                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                              CornerRadius="8" Padding="16,12" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox MinWidth="0" VerticalAlignment="Center"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind vm:Bind.CanToggle(Status), Mode=OneWay}" />
                                            <FontIcon Grid.Column="1" FontSize="22"
                                                      Glyph="{x:Bind vm:Bind.StatusGlyph(Status), Mode=OneWay}"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DeviceLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{x:Bind Manufacturer}" /><Run Text="  ·  " /><Run Text="{x:Bind DriverClass}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="Installed:" /> <Run Text="{x:Bind CurrentText}" /><Run Text="   →   New driver date:" /> <Run Text="{x:Bind NewDateText}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock Text="{x:Bind SizeText}" HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" HorizontalAlignment="Right"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ================= INSTALLED DRIVERS ================= -->
                <Grid x:Name="DriversPanel" Padding="32,24,32,24" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Installed drivers" Style="{StaticResource TitleTextBlockStyle}" />

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Filter by device, provider or class"
                                 Text="{x:Bind ViewModel.DriverFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                   Text="{x:Bind ViewModel.DriverCountText, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.LoadDriversCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Column headers -->
                    <Grid Grid.Row="2" Padding="16,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Device" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Class" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Provider" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Version" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Date" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Drivers}" SelectionMode="None"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="40" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:InstalledDriver">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DeviceName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DeviceClass}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Provider}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Version}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind DateText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- ================= SETTINGS ================= -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel Padding="32,24,32,24" Spacing="6" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

                        <TextBlock Text="Safety" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Create a restore point before installing" />
                                <TextBlock Text="Lets you roll back with System Restore if a driver causes problems." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent=""
                                          IsOn="{x:Bind ViewModel.CreateRestorePoint, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="Update source" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Use my organisation's update server (WSUS)" />
                                <TextBlock Text="Off: check Microsoft's public Windows Update catalog. Turn on only for work PCs managed by IT." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,80,0" />
                            </StackPanel>
                            <ToggleSwitch HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent=""
                                          IsOn="{x:Bind ViewModel.UseManagedServer, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="About uDrivers" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="8" Padding="16" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.VersionText}" />
                                <TextBlock Text="{x:Bind ViewModel.AppUpdateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Check for app updates" Command="{x:Bind ViewModel.CheckAppUpdateCommand}" />
                                <Button Content="Update and restart" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.InstallAppUpdateCommand}"
                                        Visibility="{x:Bind vm:Bind.VisibleIf(ViewModel.AppUpdateAvailable), Mode=OneWay}" />
                            </StackPanel>
                            <ProgressBar Grid.Row="1" Maximum="100" Value="{x:Bind ViewModel.AppUpdateProgress, Mode=OneWay}"
                                         Visibility="{x:Bind vm:Bind.VisibleIf(ViewModel.AppUpdateAvailable), Mode=OneWay}" />
                            <Grid Grid.Row="2">
                                <TextBlock Text="Check for app updates when uDrivers starts" VerticalAlignment="Center" />
                                <ToggleSwitch HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent=""
                                              IsOn="{x:Bind ViewModel.CheckAppUpdatesOnStart, Mode=TwoWay}" />
                            </Grid>
                        </Grid>

                        <HyperlinkButton Content="Open log folder" Command="{x:Bind ViewModel.OpenLogsCommand}" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
